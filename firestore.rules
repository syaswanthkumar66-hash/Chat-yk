rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} { 
      allow read, write: if false; 
    }

    // Auth Helpers
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn(); }
    function isOwner(userId) { return isVerified() && request.auth.uid == userId; }
    function isAdmin() {
      return isVerified() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function incoming() { return request.resource.data; }

    match /test/connection {
      allow read: if true;
    }

    match /system_config/{configId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read: if isVerified();
      allow write: if isVerified() && request.auth.uid == userId;
    }

    match /pushSubscriptions/{userId} {
      allow read, write: if isVerified() && (request.auth.uid == userId || isAdmin());
    }

    match /offline_messages/{messageId} {
      allow create: if isVerified();
      allow read, update, delete: if isVerified();
    }

    match /friendRequests/{requestId} {
      allow create: if isVerified();
      allow read, update, delete: if isVerified();
    }

    match /notifications/{notificationId} {
      allow create: if isVerified();
      allow read, update, delete: if isVerified();
    }

    match /uploaded_files/{fileId} {
      allow create: if isVerified() && incoming().ownerId == request.auth.uid;
      allow read: if isVerified();
      allow update, delete: if isVerified() && (resource == null || resource.data.ownerId == request.auth.uid);
    }

    match /cloud_syncs/{userId} {
      allow read, write: if isVerified() && request.auth.uid == userId;
    }

    match /data_usage/{userId} {
      allow read, write: if isVerified() && request.auth.uid == userId;
    }
  }
}
