{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in the application",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "avatar": { "type": "string" },
        "description": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "joinDate": { "type": "string" }
      },
      "required": ["id", "email", "username", "displayName"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Durable user notifications representing system alerts, messages, mentions, and friend requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderAvatar": { "type": "string" },
        "recipientId": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "chatId": { "type": "string" },
        "requestId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "type", "recipientId", "title", "body", "status", "createdAt"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "System-wide global configuration document",
      "type": "object",
      "properties": {
        "publicKey": { "type": "string" },
        "privateKey": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["publicKey", "privateKey"]
    },
    "CloudSync": {
      "title": "CloudSync",
      "description": "Database payload for the user auto-syncing across active devices",
      "type": "object",
      "properties": {
        "chats": { "type": "array" },
        "users": { "type": "array" },
        "friendRequests": { "type": "array" },
        "sentFriendRequests": { "type": "array" },
        "blockedUserIds": { "type": "array" },
        "removedFriendIds": { "type": "array" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["lastUpdated"]
    },
    "DataUsage": {
      "title": "DataUsage",
      "description": "Network data usage statistics for chat and calls in bytes",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "chatUploadBytes": { "type": "number" },
        "chatDownloadBytes": { "type": "number" },
        "callUploadBytes": { "type": "number" },
        "callDownloadBytes": { "type": "number" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["userId", "chatUploadBytes", "chatDownloadBytes", "callUploadBytes", "callDownloadBytes"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Durable user notifications"
    },
    "system_config/{configId}": {
      "schema": { "$ref": "#/entities/SystemConfig" },
      "description": "System global configuration documents (e.g., VAPID keys)"
    },
    "cloud_syncs/{userId}": {
      "schema": { "$ref": "#/entities/CloudSync" },
      "description": "Encrypted multi-device sync data"
    },
    "data_usage/{userId}": {
      "schema": { "$ref": "#/entities/DataUsage" },
      "description": "User data usage statistics for chat and calls"
    }
  }
}
